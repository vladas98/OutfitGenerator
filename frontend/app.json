{
  "expo": {
    "name": "OutfitGenerator",
    "slug": "outfitgenerator",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "ClothesApp needs access to your photos to add items to your digital closet.",
          "cameraPermission": "ClothesApp needs access to your camera to photograph clothing items."
        }
      ],
      "expo-font",
      "expo-secure-store"
    ]
  }
}
