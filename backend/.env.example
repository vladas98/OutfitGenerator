# Server
PORT=4000

# Signs login session tokens - use a long random string, e.g. `openssl rand -hex 32`.
# Changing this invalidates every existing logged-in session.
JWT_SECRET=change_me_to_a_long_random_string

# MongoDB - local example: mongodb://127.0.0.1:27017/clothesapp
# Atlas example: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/clothesapp
MONGODB_URI=mongodb://127.0.0.1:27017/clothesapp

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_VISION_MODEL=anthropic/claude-sonnet-5
OPENROUTER_TEXT_MODEL=anthropic/claude-haiku-4.5

# Shown in OpenRouter dashboards as the request source, optional but recommended
OPENROUTER_SITE_URL=http://localhost:4000
OPENROUTER_SITE_NAME=ClothesApp
